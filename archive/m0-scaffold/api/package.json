{
  "name": "@rvm-student/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest --run",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/platform/migrate.ts",
    "db:new": "drizzle-kit generate",
    "openapi:build": "tsx src/platform/openapi.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.1.0",
    "@fastify/swagger": "^9.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@sentry/node": "^8.0.0",
    "drizzle-orm": "^0.31.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^4.0.0",
    "jose": "^5.6.0",
    "pg": "^8.12.0",
    "pg-boss": "^10.1.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.8.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.22.0",
    "testcontainers": "^10.8.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
