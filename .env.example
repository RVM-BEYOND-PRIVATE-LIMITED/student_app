# Copy to .env (never commit real values)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Shared Supabase Postgres — STAGING ONLY for dev/agent. Never prod.
DATABASE_URL=postgres://lms_app:change-me@db-staging:5432/postgres?sslmode=require
DIRECT_URL=postgres://lms_migrator:change-me@db-staging:5432/postgres?sslmode=require
PG_POOL_MAX_API=10
PG_STATEMENT_TIMEOUT_MS=15000

# Auth (EdDSA). Generate with `jose` keypair; store private JWK in secrets manager.
JWT_PRIVATE_JWK_JSON={}
JWT_PUBLIC_JWK_JSON={}
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Service-to-service (team app <-> this API)
INTERNAL_SERVICE_TOKEN=change-me
INTERNAL_IP_ALLOWLIST=127.0.0.1

# Vendor
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VDOCIPHER_API_SECRET=
LIVE_PROVIDER=100ms
SMS_PROVIDER_URL=
GALLABOX_API_KEY=
FCM_SERVICE_ACCOUNT_JSON={}
S3_BUCKET=
S3_REGION=ap-south-1
SENTRY_DSN=
AUDIT_MODE=on
