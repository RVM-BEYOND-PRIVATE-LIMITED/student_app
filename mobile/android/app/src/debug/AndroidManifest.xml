<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android's own network stack only (Java/Kotlin): cleartext to this
         computer in debug builds (res/xml/network_security_config.xml).
         Dart traffic, the Student API's included, is not covered by it: see
         lib/core/network/host_guard.dart. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
