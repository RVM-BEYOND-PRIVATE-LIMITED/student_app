<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ in dark mode: the same navy splash as values-v31 (the
         night qualifier outranks the API level, so it needs its own copy). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_navy</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/launch_navy</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_navy</item>
    </style>
</resources>
